{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "better-gradient",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "better-gradient.com",
			"custom_domain": true
		}
	],
	"preview_urls": false,
	"keep_vars": true,
	"assets": {
		"directory": ".cloudflare/worker/public",
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "BUDGET",
				"class_name": "UsageBudget"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "VIDEOS",
			"bucket_name": "better-gradient-public-videos"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BetterGradientApp"]
		},
		{
			"tag": "v2-browser-run",
			"deleted_classes": ["BetterGradientApp"],
			"new_sqlite_classes": ["UsageBudget"]
		}
	],
	"observability": {
		"enabled": false
	},
	"browser": {
		"binding": "BROWSER"
	},
	"limits": {
		"cpu_ms": 200
	}
}
